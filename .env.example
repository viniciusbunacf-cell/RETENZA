# ---------------------------------------------------------------------------
# RETENZA — variáveis de ambiente
# Copie para .env.local e ajuste. Sem nenhuma variável, a aplicação sobe em
# modo demonstração com um PostgreSQL embarcado (PGlite) gravado em .data/.
# ---------------------------------------------------------------------------

# PostgreSQL de produção (Supabase, RDS, Neon...). As migrações em drizzle/
# são aplicadas automaticamente na primeira conexão.
# DATABASE_URL=postgres://usuario:senha@host:5432/retenza

# Segredo usado para assinar a sessão. Obrigatório em produção (mín. 32 caracteres).
# Gere com: openssl rand -hex 32
# SESSION_SECRET=

# Segredo do agendador de recálculo diário (POST /api/cron/recalcular).
# O endpoint fica desativado enquanto esta variável não existir.
# CRON_SECRET=

# Modo demonstração: cria um provedor fictício e mostra o acesso na tela de login.
# Padrão: ligado sem DATABASE_URL, desligado com DATABASE_URL.
# RETENZA_DEMO=false

# Defina como false para aplicar as migrações manualmente.
# RETENZA_AUTO_MIGRATE=true

# Tamanho do pool de conexões (padrão 5; use valores baixos em ambiente serverless).
# DATABASE_POOL_MAX=5

# Pasta do banco embarcado (padrão: .data/pglite).
# RETENZA_DATA_DIR=

# ---------------------------------------------------------------------------
# Site de divulgação: pedidos de demonstração
# ---------------------------------------------------------------------------

# E-mail que recebe cada pedido de demonstração (também aparece no site).
# RETENZA_CONTATO_EMAIL=

# WhatsApp comercial com DDD (ex.: 11912345678). Aparece no site e recebe o
# pedido quando o visitante toca em "Enviar pelo WhatsApp".
# RETENZA_CONTATO_WHATSAPP=

# Chave do serviço de e-mail Resend (resend.com), necessária para o aviso por e-mail.
# RESEND_API_KEY=

# Remetente dos avisos, em um domínio verificado no Resend.
# Sem domínio verificado, o Resend só entrega no e-mail da própria conta.
# RETENZA_EMAIL_REMETENTE="RETENZA <avisos@seudominio.com.br>"

# E-mails (separados por vírgula) que veem a lista de pedidos em /demonstracoes.
# RETENZA_ADMIN_EMAILS=
